# Persistent names for the two FlexiTac readout boards, same idea as /dev/dxl_right and /dev/dxl_left.
# Find each board's serial (plug in one at a time):
#   udevadm info -a -n /dev/ttyUSB0 | grep -E 'serial|idVendor|idProduct'
# Install:
#   sudo cp 99-tactile-pads.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   ls -l /dev/tactile_right /dev/tactile_left
#
# If the readout boards are Arduino clones with a CH340 chip they often share the SAME serial
# string; then key on the physical USB port instead with KERNELS=="1-2.3" (from the same
# udevadm output) and always plug each pad into the same port.

SUBSYSTEM=="tty", ATTRS{serial}=="<RIGHT_PAD_SERIAL>", SYMLINK+="tactile_right", MODE="0666"
SUBSYSTEM=="tty", ATTRS{serial}=="<LEFT_PAD_SERIAL>", SYMLINK+="tactile_left", MODE="0666"

# /arm/<side>/grasp
#
# GRASP: close until the pad reports contact, squeeze until `total` reaches target_total (or the
#        squeeze limit), then succeed. The node keeps holding after the result, re-tightening on
#        slip, until the next goal. Watch /arm/<side>/grasp_state for LOST while carrying.
# OPEN:  move to the open position, stop holding, and (by default) re-zero the pad once open.
# Zero-valued optional fields mean "use the node parameter".

uint8 GRASP=0
uint8 OPEN=1
uint8 command
float32 target_total          # contact signal to squeeze to (counts), 0 = parameter target_total
float32 close_speed           # rad/s while approaching, 0 = parameter close_speed
float32 timeout_s             # 0 = parameter goal_timeout_s
---
uint8 GRASPED=0               # contact made and target total reached
uint8 GRASPED_WEAK=1          # contact made, squeeze limit reached before the target total
uint8 OPENED=2
uint8 NO_OBJECT=3             # reached the closed limit without contact
uint8 STALLED=4               # finger stopped moving but the pad saw nothing (object off the pad?)
uint8 SENSOR_FAULT=5          # pad disconnected, stale or uncalibrated
uint8 ARM_UNAVAILABLE=6       # no /joint_states for this gripper, or motion_allowed is false
uint8 TIMEOUT=7
uint8 CANCELED=8

bool success
uint8 outcome
string message
float32 gripper_position      # rad
float32 contact_position      # rad, NaN if no contact
float32 total
int32 contact_taxels
---
uint8 state                   # GraspState constants
float32 gripper_command
float32 gripper_position
float32 total
int32 contact_taxels
bool in_contact
